{
  "name": "strokealert",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:api": "bun run --filter '@strokealert/api' dev",
    "dev:web": "bun run --filter '@strokealert/web' dev",
    "build": "bun run --filter '@strokealert/shared' build && bun run --filter '@strokealert/api' build && bun run --filter '@strokealert/web' build",
    "start": "bun run --filter './apps/*' start",
    "start:api": "bun run --filter '@strokealert/api' start",
    "start:web": "bun run --filter '@strokealert/web' start",
    "lint": "bun run --filter '@strokealert/web' lint",
    "type-check": "bun run --filter './apps/*' type-check",
    "gen:nepal-map": "node scripts/gen-nepal-map.js apps/web/src/app/data/nepal-map.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=18.0.0"
  }
}
